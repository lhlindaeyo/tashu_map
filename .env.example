# 공공데이터포털에서 발급받은 인증키입니다. 서비스마다 달라도 되고, 같은 키여도 됩니다.
# 값 뒤에 주석을 붙이지 마세요. 줄 전체가 값으로 읽힙니다.

# 대전광역시_버스정류소조회서비스 (아래 두 키가 비어 있으면 대신 사용)
BUS_API_KEY=

# 대전광역시_노선정보조회 (fetch_bus.js 에서 사용)
BusRouteInfoServiceKey=

# 대전광역시_정류소별_도착정보_조회 (server.js 에서 사용)
BusArrivalInfoServiceKey=

# 카카오 개발자 > 앱 키 > REST API 키 (대여소 주소를 좌표로 바꿀 때 geocode.js 에서 1회 사용)
KAKAO_REST_KEY=

# 타슈 앱 > 자전거정보 > OpenAPI 에서 신청해 받은 인증키 (server.js 에서 사용)
# 비워 두면 남은 자전거 수는 추정값으로 보여 줍니다.
TashuApiKey=
